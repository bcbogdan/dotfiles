{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "model": "openai/gpt-5.2-codex",
  "provider": {
    "openai": {
      "options": {
        "timeout": 600000,
        "setCacheKey": true
      }
    }
  },
  "mcp": {
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": true
    }
  }
}
